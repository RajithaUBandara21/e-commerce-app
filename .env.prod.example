# Copy to .env.prod on the deployment VM, fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public IP or domain of the VM — every browser-facing URL (frontend, the
# gateway the frontend's client bundle calls, Keycloak login redirects,
# MinIO product-image URLs, the Grafana link) is built from this. If you
# later point a domain at the VM, change this one value and rebuild.
DEPLOY_HOST=REPLACE_WITH_VM_PUBLIC_IP

# Infra credentials — same defaults as local dev, change if you want.
POSTGRES_USER=rajitha
POSTGRES_PASSWORD=rajitha
MONGO_ROOT_USER=rajitha
MONGO_ROOT_PASSWORD=rajitha
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
MINIO_ROOT_USER=rajitha
MINIO_ROOT_PASSWORD=rajitha123

# Filled in after running keycloak/setup-seller-service-client.sh against
# this deployment's Keycloak (see DEPLOY.md) — empty means Stripe-Connect
# onboarding role-grants will fail closed, same as local dev.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Empty by default — Stripe charges fail closed with a clear reason until a
# real test-mode key is set, same as local dev.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
