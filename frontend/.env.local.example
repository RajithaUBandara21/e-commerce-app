# Copy to .env.local and fill in for local development.

# api-gateway base URL (see services/api-gateway/Dockerfile EXPOSE)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8222

# NextAuth
AUTH_SECRET=replace-with-output-of-`npx auth secret`
AUTH_KEYCLOAK_ID=nextjs-storefront
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/micro
