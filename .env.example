# Copy to .env and fill in for local development. `docker compose` auto-loads
# .env from this directory for the containers below. The 10 Spring Boot
# services are NOT containerized (see CLAUDE.md's "Local infrastructure") — they
# run on the host via `mvn spring-boot:run`/`java -jar`, so these same variables
# also need to be exported in whatever shell/IDE run config launches each one;
# docker-compose can't pass them through automatically.
#
# Every value below is a local-dev default already baked into docker-compose.yml
# or a service's application.yml as a "${VAR:-default}" fallback — .env lets you
# override them without editing tracked files, it doesn't introduce new secrets.

# --- Infra credentials (docker-compose.yml) ---
POSTGRES_USER=rajitha
POSTGRES_PASSWORD=rajitha
MONGO_ROOT_USER=rajitha
MONGO_ROOT_PASSWORD=rajitha
PGADMIN_DEFAULT_EMAIL=pgadmin@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
MINIO_ROOT_USER=rajitha
MINIO_ROOT_PASSWORD=rajitha123
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- config-server ---
# GitHub personal access token for the external e-com-app-config repo (read-only
# is enough). The token previously hardcoded here was committed to git history
# and needs revoking on GitHub — see CLAUDE.md's Gotchas — this variable is the
# fix, not a restatement of the old value.
GITHUB_TOKEN=

# --- payment-service / seller-service (Stripe) ---
# Empty by default — Stripe calls fail closed until a real test-mode key is set
# (see CLAUDE.md's payment-service description).
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- payment-service ---
PLATFORM_COMMISSION_RATE=0.10
PAYOUT_SETTLEMENT_CRON=0 0 3 * * *
SELLER_SERVICE_URL=http://localhost:8095/api/v1/sellers

# --- seller-service (Keycloak Admin API service account) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=micro
KEYCLOAK_ADMIN_CLIENT_ID=seller-service
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_SELLER_ROLE=seller
FRONTEND_ORIGIN=http://localhost:3000

# --- product-service (MinIO) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_PRODUCT_IMAGES_BUCKET=product-images
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# --- api-gateway ---
REDIS_HOST=localhost
REDIS_PORT=6379
